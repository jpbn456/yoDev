{
  "name": "yodev-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply yodev --local",
    "db:migrate:remote": "wrangler d1 migrations apply yodev --remote",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  }
}
