# Development defaults use SQLite. Railway supplies DATABASE_URL from its PostgreSQL service.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=yoDev <noreply@your-domain.com>
RESEND_API_KEY=re_replace_me
# Only enable after Railway terminates HTTPS for the public domain.
SECURE_SSL_REDIRECT=false
