{
  "name": "yodev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "test": "vitest run tests && npm --prefix frontend test && npm --prefix cloudflare test",
    "typecheck": "tsc --noEmit && npm --prefix cloudflare run typecheck",
    "db:migrate": "tsx scripts/migrate-turso.ts",
    "db:migrate:local": "TURSO_DATABASE_URL=file:./.tmp/yodev.db tsx scripts/migrate-turso.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@vercel/node": "12.0.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
